# hostapd.conf.template - Generated at runtime by hwphonelinkd
# Do not edit directly - use hwphonelinkd configuration

interface=@AP_INTERFACE@
driver=nl80211
ssid=@SSID@
hw_mode=@HW_MODE@
channel=@CHANNEL@
ieee80211n=1
ieee80211ac=1
wpa=2
wpa_passphrase=@PASSPHRASE@
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wmm_enabled=1
ieee80211d=1
country_code=CN
ieee80211h=1

# Logging
logger_syslog=-1
logger_syslog_level=2
logger_stdout=-1
logger_stdout_level=2

# P2P (if needed)
# p2p=1
# p2p_go_intent=15