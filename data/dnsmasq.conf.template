# dnsmasq.conf.template - Generated at runtime by hwphonelinkd
# Do not edit directly - use hwphonelinkd configuration

interface=@AP_INTERFACE@
bind-interfaces
dhcp-range=@DHCP_START@,@DHCP_END@,12h
dhcp-option=3,@AP_IP@
dhcp-option=6,@AP_IP@
no-hosts
addn-hosts=@CONFIG_DIR@/hosts
log-queries
log-dhcp
pid-file=@RUN_DIR@/dnsmasq.pid
dhcp-leasefile=@RUN_DIR@/dnsmasq.leases
dhcp-authoritative

# DNS forwarding (optional, for phone internet access)
# server=8.8.8.8
# server=1.1.1.1

# TFTP (for future use)
# enable-tftp
# tftp-root=@RUN_DIR@/tftp